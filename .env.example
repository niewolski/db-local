# =================== SQL Server =====================
# Tylko użytkownik "sa". Hasło musi mieć min. 8 znaków i 3 z 4: wielkie, małe, cyfry, znaki specjalne
MSSQL_SA_PASSWORD=
MSSQL_PORT=1433

# ====================== Redis =======================
